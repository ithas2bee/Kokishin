{
  "OpenApi": {
    "ExposeInProduction": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "UseUtcTimestamp": true,
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*"
}
